# ── そなえ MVP 環境変数 ───────────────────────────────
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
# .env は .gitignore 済み（コミットしないこと）

# ── データベース (SQLite) ──────────────────────────────
# ローカル検証用。将来は Postgres の接続文字列に差し替え可能。
DATABASE_URL="file:./dev.db"

# ── セッション署名鍵 ──────────────────────────────────
# ログインセッション Cookie の署名に使う。長いランダム文字列を設定。
#   例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Google OAuth 2.0 / Google Calendar API ───────────
# Google Cloud Console で OAuth クライアント（種別: ウェブアプリケーション）を作成し取得。
#   - 承認済みリダイレクト URI に GOOGLE_REDIRECT_URI と同じ値を登録すること
#   - 有効化する API: Google Calendar API
#   - OAuth 同意画面のスコープ: .../auth/calendar.readonly, openid, email, profile
#   - テスト中はテストユーザーに検証メンバー（3〜5名）の Google アカウントを追加
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# ローカル: http://localhost:3000/api/auth/google/callback
# 本番:     https://<your-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── OpenAI API（準備リスト自動生成に使用）────────────
# ユーザー保有の OpenAI キーを使用。未設定でもカテゴリ別テンプレートで動作する。
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ── アプリの公開 URL（OAuth リダイレクト等の絶対 URL 生成に使用）──
# 本番では https://<your-app>.onrender.com
APP_BASE_URL="http://localhost:3000"

# ── Web Push 通知 ────────────────────────────────────
# VAPID 鍵を生成:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BB...(公開鍵)"
VAPID_PRIVATE_KEY="..(秘密鍵)"
VAPID_SUBJECT="mailto:you@example.com"

# ── 新規予定ポーリング (Render Cron から叩く) ─────────
# /api/cron/poll を呼ぶときに x-cron-secret ヘッダで一致を要求する共有シークレット
#   例: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="change-me-random-hex"

# ── 開発用ログイン ───────────────────────────────────
# 本番(NODE_ENV=production)では自動的に無効。明示的に有効化したいときだけ true。
# ENABLE_DEV_LOGIN="false"
