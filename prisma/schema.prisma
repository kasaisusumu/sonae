// そなえ MVP — Prisma schema (PostgreSQL: 本番 Neon / ローカルも Neon 可)
// Data model follows docs/CLAUDE.md section 4.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  // native = ローカル、rhel-openssl-3.0.x = Vercel(サーバーレス)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // アプリ実行用（Neon の pooled 接続文字列）
  directUrl = env("DIRECT_URL")   // マイグレーション用（Neon の直結 接続文字列）
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())
  // 導入チュートリアル（概念スライド）を完了/スキップした日時。
  // PWA を「ホーム画面に追加」すると localStorage が別ストレージになり
  // チュートリアルが再表示されるため、完了状態はサーバー側でも持つ。
  tutorialSeenAt DateTime?
  // 説明欄のリンクから開いたときに出す「直接編集できます」案内を、
  // 「今後表示しない」で消したかどうか。null の間は毎回表示する。
  descLinkHintDismissedAt DateTime?

  googleAccount  UserGoogleAccount?
  categories     Category[]
  events         Event[]
  failureLogs    FailureLog[]
  savingsEntries SavingsEntry[]
  feedback       Feedback[]
  pushSubscriptions PushSubscription[]
  listTemplates  ListTemplate[]
  failureDismissals FailureDismissal[]
  activityMinutes   ActivityMinute[]
  featureEvents     FeatureEvent[]
  futureMessages    FutureMessage[]
  eventFutureMessages EventFutureMessage[]
  messageProposalRecords MessageProposalRecord[]
  checklistScopeRules ChecklistScopeRule[]
  eventChecklistScopes EventChecklistScope[]
}

// Web Push の購読情報（1 ユーザーが複数端末を持てる）
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Google 連携用トークン管理。ログイン(認証)もこのアカウントで兼ねる。
model UserGoogleAccount {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccountEmail String
  accessToken        String
  refreshToken       String?
  tokenExpiry        DateTime?
  calendarId         String    @default("primary")
  lastSyncedAt       DateTime?
  // 差分同期トークン（events.list の nextSyncToken）
  syncToken          String?
  // Google Calendar push 通知（watch チャンネル）
  watchChannelId     String?
  watchResourceId    String?
  watchExpiration    DateTime?
  // 予定の説明欄への準備リスト書き込み。既定 true（初回連携で calendar.events も要求）。
  // 設定でいつでもオフにできる。calendar.events 未許可なら書き込みは黙って失敗する。
  writeDescriptionEnabled Boolean @default(true)
  // 直近の取り込みで失敗したか（例: "reauth_required" = Google 側でトークン失効・取り消し）。
  // 成功した取り込みで null に戻す。設定画面で「再接続してください」の表示に使う。
  syncError          String?
  syncErrorAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  events       Event[]
  learnedRules LearnedRule[]
  editRecords  EditRecord[]
  failureLogs  FailureLog[]

  @@unique([userId, name])
}

model Event {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title         String
  eventDatetime DateTime
  endDatetime   DateTime?
  memo          String?
  // Google のイベント ID。ユーザーをまたいで一意にはしない（下の @@unique 参照）。
  googleEventId String?
  // 繰り返し予定の親イベントID（Google）。同じ系列の通知・生成をまとめるのに使う
  recurringEventId String?
  // 自動で準備リスト生成・説明欄書き込みの対象にするか。
  // 連携時に既にあった予定は false（無視）。連携後に追加された予定・アプリで編集した予定は true。
  autoManaged   Boolean   @default(true)
  // この予定の準備リストを個別に編集して、同名グループから切り離したか。
  // false = 同名の未編集予定と内容を共有（一方の編集は全体に波及）。
  listCustomized Boolean  @default(false)
  // ユーザーが準備リストを意図的に「全部消した」状態。
  // true の間は自動生成・自動提案をしない（似た予定でも「何も出さない」を学習する）。
  // 項目が1つでも足されると false に戻る。
  listCleared   Boolean  @default(false)
  // 準備リストの「枠」（セクション）のキーと表示順。JSON string[]。
  // 既定は ["task","belonging"]（＝準備すること・持ち物）。ユーザーが枠を足すとキーが増える。
  sectionOrder  String   @default("[\"task\",\"belonging\"]")
  // 生成されたリストを、編集せずに「確認しました」と押した日時。
  // これが null かつ EditRecord も無いと「未確認」表示（説明欄にも注記）。
  listReviewedAt DateTime?
  source        String    @default("manual") // "google" | "manual"
  // 再発防止の警告をユーザーが確認・了承した日時（設定されると警告は畳まれる）
  failureWarningAckAt DateTime?
  // 予定終了後の「失敗あった？」に対して「なかった」を押した日時。
  // 事後通知の対象外にし、予定ページの確認プロンプトも畳む。
  noFailureAt   DateTime?
  // 新規追加の通知を送った日時（アプリを開いたときの準備リスト先行生成にも使う）
  notifiedAt    DateTime?
  // そなえが最後に説明欄へ書き込んだ内容のハッシュ（無限ループ／再書き込み防止）
  lastWrittenHash String?
  // 直近に取り込んだ「受信テキスト」のハッシュ（webhook と cron の二重取り込み・二重学習を防ぐ）
  lastInboundHash String?
  // （旧）クールダウン用。現在は未使用
  lastInboundEditAt DateTime?
  // 事後の「今回は防げた？」通知を送った日時（再送防止）
  postFailureCheckNotifiedAt DateTime?
  // 準備リスト全体のリマインド通知。予定開始の何分前に「準備リストを確認しましょう」を送るか。
  // listReminderLeads = JSON の number[]（分・最大5個、早い順）。[] = 送らない。
  // listReminderLeadMinutes は先頭値のミラー（後方互換）。
  listReminderLeadMinutes Int? @default(1440)
  listReminderLeads       String @default("[1440]")
  // すでに送信済みのリード時間（JSON number[]）。leads を変えると [] にリセット。
  sentListReminderLeads   String @default("[]")
  listReminderNotifiedAt  DateTime?
  // ユーザーが明示的にリマインドを変えた日時。null = まだ既定のまま（学習で上書きしてよい）。
  listReminderTouchedAt   DateTime?
  // 「未来の自分へのメッセージ」の AI 判定（genre_ai / similar_ai）を、この予定に対して
  // 一度試したか（結果の有無に関わらず）。予定ごとに 1 回だけに抑えるためのキャッシュ。
  // キーワード／ジャンル関連語／カテゴリ一致（安価な判定）はこれと無関係に毎回試す。
  futureMessageCheckedAt DateTime?
  // 予定後の「メッセージを更新しませんか？」通知を送った日時（旧 postFailureCheckNotifiedAt
  // に相当。1予定1回の送信管理。cron から呼ぶ notifyPendingMessageReviews が使う）。
  messageReviewNotifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checklistItems ChecklistItem[]
  savingsEntries SavingsEntry[]
  failureLogs    FailureLog[]
  feature        EventFeature?
  editRecords    EditRecord[]
  failureDismissals FailureDismissal[]
  checklistItemImages ChecklistItemImage[]
  futureMessageLinks EventFutureMessage[]
  messageProposalRecords MessageProposalRecord[]
  eventChecklistScopes EventChecklistScope[]

  @@index([userId, recurringEventId])
  // 招待・共有された予定は Google 側で複数ユーザーの予定に同じ googleEventId が
  // 付くことがある（例: 同じ会議に招待された2人のテストユーザー）。ここをユーザー
  // 横断で一意にすると、後から連携した側の取り込みが「重複」扱いで黙って
  // 失敗する（相手の予定は無事だが、自分の予定が一切取り込まれない）。
  // ユーザーごとに一意にして、各自が自分の予定として正しく取り込めるようにする。
  @@unique([userId, googleEventId])
}

// 準備リストの「各項目のメモ」に貼り付けた画像。
// クライアントで長辺 1280px・品質 70% ほどに圧縮してからデータ URL（WebP/JPEG）で保存。
// Google カレンダーには同期しない（アプリ内のみ。リンクは comment 経由で説明欄にも出る）。
// saveChecklist は項目行を毎回作り直すため、画像は項目 id ではなく
// (eventId, kind, slot=正規化タイトル) で紐づけ、タイトルが残る限り画像も追従する。
// ストレージを圧迫しないよう 1 項目あたりの枚数と 1 枚のサイズに上限を設ける。
model ChecklistItemImage {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind      String   // "task" | "belonging" | ユーザー枠名
  slot      String   // 正規化した項目タイトル（小文字・空白除去）
  data      String   // data:image/webp;base64,... （圧縮済み）
  width     Int
  height    Int
  bytes     Int      // デコード後のおおよそのバイト数（目安表示・集計用）
  createdAt DateTime @default(now())

  @@index([eventId, kind, slot])
}

model ChecklistItem {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // "task" = 準備すること / "belonging" = 持ち物
  kind          String   @default("task")
  title         String
  timingLabel   String? // 例: "前日21時"
  comment       String? // ユーザーの自由メモ（学習対象外）
  isDone        Boolean  @default(false)
  isUserAdded   Boolean  @default(false)
  isUserRemoved Boolean  @default(false)
  sortOrder     Int      @default(0)
  // この項目の準備を促す通知を、予定開始の何分前に出すか。null = 通知しない。
  notifyLeadMinutes Int?
  // その通知を送った日時（再送防止）。リード時間を変えると null に戻す。
  notifiedAt        DateTime?
  createdAt     DateTime @default(now())

  // confidence の低い「提案」項目（ユーザーが1タップで適用/却下）
  isSuggested      Boolean @default(false)
  // "exclude" | "add" | "timing" | "pattern_analogy"（カテゴリ横断パターンから
  // そのまま確定項目として追加したもの。isSuggested は false のまま＝通常項目と同じ見た目）
  suggestionType   String?
  suggestionRuleId String? // 元になった LearnedRule.id
  suggestionValue  String? // timing 提案のときの提案タイミング / pattern_analogy の確定タイトル

  // この項目が名前付きリスト（ListTemplate）の適用・そのままの自動再利用で追加された
  // ものなら、その元テンプレート。saveChecklist で保存し直すたびに（他フィールドと違い）
  // 引き継がない＝「そのまま」でいられた最初の1回だけの印。中身の編集（タイトルの
  // 追加/削除）を検知して枠名を「◯◯（編集済み）」に変える判定に使う。
  sourceTemplateId String?
  sourceTemplate   ListTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)

  @@index([sourceTemplateId])
}

// ── 学習ロジック（spec 9.2）: EventFeature + EditRecord + LearnedRule ──

// 予定の特徴量（軽いルールベース推定）
model EventFeature {
  id             String   @id @default(cuid())
  eventId        String   @unique
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isOverseas     Boolean? // タイトル・メモのキーワードから推定（不明なら null）
  durationNights Int? // 日付範囲から算出（日帰り=0、不明なら null）
  isWeekday      Boolean  @default(true)
  timeBucket     String? // "morning" | "afternoon" | "evening" | "allday"
  keywords       String   @default("[]") // json string[]
  // 予定自体の所要時間バケット（endDatetime - eventDatetime）。
  // "short" | "half_day" | "full_day"。不明（終了時刻なし等）なら null。
  // featureSignature には含めない（既存の同一カテゴリ学習の枝分かれ方を変えないため。
  // 詳細は lib/signature.ts のコメント参照）。将来の分析用に保存だけしておく。
  eventLengthBucket String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 個々の編集の生ログ（イベント単位）
model EditRecord {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  addedItems    String    @default("[]") // json [{title, timingLabel}]
  removedItems  String    @default("[]") // json string[]
  timingChanges String    @default("{}") // json { title: timingLabel }
  notifyChanges String    @default("{}") // json { title: leadMinutes | null }
  createdAt     DateTime  @default(now())

  @@index([categoryId])
}

// EditRecord を集約した、提案時に参照するルール
model LearnedRule {
  id                String   @id @default(cuid())
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  featureSignature  String   @default("{}") // json {d?:duration, o?:overseas, w?:weekday, t?:timeBucket}
  itemKind          String   @default("task") // "task" | "belonging"
  ruleType          String // "exclude_item" | "fixed_item" | "timing_override" | "notify_override" | "pattern_item"
  target            String // 対象項目名
  value             String? // timing_override / fixed_item のタイミングラベル
  confidence        Float    @default(0.35) // 0-1。反復確認で上昇、矛盾で低下、未更新で経年劣化
  confirmedCount    Int      @default(1) // 連続確認回数（矛盾でリセット）。pattern_item は別の数え方（下記）
  contradictedCount Int      @default(0) // 矛盾が起きた累計
  lastConfirmedAt   DateTime @default(now())
  isUserLocked      Boolean  @default(false) // 「学習内容の確認」画面で固定した
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ── ruleType="pattern_item" 専用（カテゴリ横断のパターン提案） ──
  // 「バスの時間を確認する」のような項目が別カテゴリでも転用できるかを AI で判定した結果。
  // confirmedCount/contradictedCount は上の一般ルールと同じ列を使うが、意味が違う:
  // ここでは「単純な採用/却下の差分カウント」（computeConfidence は使わない）。
  slotType        String? // 一般化した対象の種類。例: "交通手段"（pattern_item のときのみ使用）
  patternTemplate String? // 一般化テンプレート。例: "{slot}の時間を確認する"
  aiConfidence    Float? // AI による初回判定時の確信度（0.0〜1.0）

  @@unique([categoryId, itemKind, ruleType, target, featureSignature])
  @@index([categoryId, itemKind, ruleType])
  @@index([ruleType, slotType])
}

model FailureLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // どの予定で起きた失敗か（任意）。指定すると、その予定に似た予定でだけ警告する
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // 失敗の内容（自由記述）。「遅刻した」「保険証を忘れた」など。金額はなくてよい
  description      String
  // 予定の特徴シグネチャ（spec 9.2 の {d,o,w,t}）。記録時にその場で確定する。
  // "{}" は「予定に紐づかない＝カテゴリ全体」を意味し、どの予定にも当たる。
  featureSignature String   @default("{}")
  // 推定損失額（円）。UI では入力させず金額表示もしない旧フィールド（後方互換のため残す）。
  estimatedLossYen Int      @default(0)
  // 有効だった対策（自由記述・任意）。「防げた」ときに何をしたかを書いてもらう。
  // 似た失敗の候補を出すときに対策候補としても引き継がれる（learning と同じ要領）。
  countermeasure   String?
  // 振り返りの結果: null = 未選択 / "prevented" = 防げた / "not_prevented" = 防げなかった
  // ダッシュボードには "prevented" のものだけ残す。未選択は失敗ログ一覧で選ぶ。
  outcome          String?
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  savingsEntries SavingsEntry[]

  @@index([userId, categoryId])
}

model SavingsEntry {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  failureLogId    String?
  failureLog      FailureLog? @relation(fields: [failureLogId], references: [id], onDelete: SetNull)
  amountYen       Int         @default(0)
  confirmedByUser Boolean     @default(false)
  createdAt       DateTime    @default(now())

  // 1 予定 × 1 失敗ログ につき「防げた」は 1 回だけ計上する
  @@unique([eventId, failureLogId])
}

// 簡易フィードバック導線 (WTP アンケート)
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wtpYen    Int? // 月いくらなら払いたいか
  comment   String?
  screen    String? // どの画面から送信されたか
  createdAt DateTime @default(now())
}

// 管理画面（/admin）の「利用時間」用の軽量な活動ログ。ログイン中のアクセスのたびに
// 「このユーザー・この分」を 1 行だけ記録する（同じ分に何度アクセスしても増えない）。
// ページの内容・操作の中身は記録しない（量＝アクティブだった分数だけを見る）。
model ActivityMinute {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minuteAt DateTime // その分の開始時刻（UTC・秒以下は切り捨て）
  dayKey   String   // JST 日付 "YYYY-MM-DD"（管理画面の日別集計を軽くする非正規化）

  @@unique([userId, minuteAt])
  @@index([userId, dayKey])
}

// 管理画面（/admin）の「機能・ページ利用状況」用。呼ばれるたびに 1 行追加する
// 素朴なイベントログ（ActivityMinute と違い分単位の重複排除はしない＝頻度そのものを見る）。
// eventKey は "page:/events" / "feature:dictation" / "infohint:xxx" /
// "popup:tutorial:shown" のような、lib/track-catalog.ts で定義した固定の識別子。
model FeatureEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey   String
  occurredAt DateTime @default(now())

  @@index([userId, eventKey])
  @@index([eventKey, occurredAt])
}

// 名前を付けて保存できる準備リストのテンプレート。
// 「準備すること(task)」用と「持ち物(belonging)」用で分ける。
// 予定の現在のリストから作るほか、学習内容ページで新規作成・編集もできる。
model ListTemplate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String   @default("task") // "task" | "belonging"
  name          String
  note          String?
  sourceEventId String? // どの予定のリストから作ったか（参照用）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items ListTemplateItem[]
  seededChecklistItems ChecklistItem[]

  @@unique([userId, kind, name])
  @@index([userId])
}

model ListTemplateItem {
  id                String       @id @default(cuid())
  templateId        String
  template          ListTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind              String       @default("task") // "task" | "belonging"
  title             String
  notifyLeadMinutes Int?
  sortOrder         Int          @default(0)

  @@index([templateId])
}

// 予定ページの「失敗ログの提案」で「今回は関係ない」と却下したもの。
// 同じ内容（正規化した説明）は、その予定では以後提案しない。
model FailureDismissal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  descKey   String // 正規化した説明（clusterKey）
  createdAt DateTime @default(now())

  @@unique([eventId, descKey])
  @@index([userId])
}

// ── 未来の自分へのメッセージ（spec: 未来の自分へのメッセージ機能） ──
// 失敗ログ機能は全廃したが、上のテーブル（FailureLog / SavingsEntry /
// FailureDismissal）と Event.noFailureAt 等の既存列はあえて削除せず未使用のまま
// 残している（本番昇格時に段階移行できるように。コード・UI からの参照だけを外す）。

// 「いつ入るか分からない予定」のために先に書いておくメッセージ。全クエリで
// userId を条件に含めること（他ユーザーの行を横断で返す finaMany を書かない）。
model FutureMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  // 以下すべて JSON 文字列（Postgres の配列型ではなく、既存 schema の他モデル
  // ―EventFeature.keywords 等―に合わせて string[] の JSON エンコードで統一）。
  keywords      String @default("[]") // json string[]
  genres        String @default("[]") // json string[]。ユーザー指定のジャンル（例「飲み会系」）。最大5個
  genreKeywords String @default("[]") // json {genre:string, terms:string[]}[]。AIがジャンルから展開した関連語（編集可）
  categoryIds   String @default("[]") // json string[]（Category.id）。空なら未指定
  // "similar"（似た予定で提案）| "keyword"（キーワード一致のみ、既定）| "once"（今回だけ、確定後 archivedAt をセット）
  scope       String    @default("keyword")
  archivedAt  DateTime? // "once" 確定時、または手動アーカイブでセット
  // どんな種類の予定向けかのAI生成の短い説明（similar_ai 判定の事前フィルタ・few-shot に使う）
  contextSummary   String?
  sourceEventTitle String?
  sourceCategoryId String?
  confirmedCount  Int       @default(0)
  lastConfirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventLinks EventFutureMessage[]
  proposals  MessageProposalRecord[]

  @@index([userId])
}

// 予定 × メッセージ の結びつき（一致判定の結果・提示状態）。
model EventFutureMessage {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messageId String
  message   FutureMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "shown"（提示中）| "removed"（この予定からだけ外した）| "confirmed"（予定後に確定）| "skipped"（今回は更新しない）
  status      String    @default("shown")
  // "keyword" | "genre_keyword" | "genre_ai" | "category" | "similar_ai" | "manual"
  matchedBy   String
  matchReason String?
  notifiedAt       DateTime? // 一致時のプッシュ（1予定1回）
  reviewNotifiedAt DateTime? // 予定後の確定うながしプッシュ（1予定1回）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, messageId])
  @@index([userId])
  @@index([messageId])
}

// 予定後の確定カードで「提案した内容」と「最終的にユーザーが確定した内容」の記録。
// 次回以降の提案（初期選択・修正されにくい根拠文）をそのユーザー自身の傾向から
// 改善するための学習データ。他ユーザーのデータは一切参照しない。
model MessageProposalRecord {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId    String
  message      FutureMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  proposed     String // json {body,keywords,genres,categoryIds,scope}
  final        String // json {body,keywords,genres,categoryIds,scope}
  fieldChanged String // json {body,keywords,genres,categoryIds,scope}（各 boolean）
  acceptedAsIs Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([messageId])
}

/// 準備リストの項目を「次回いつ出すか」の範囲つきルール（追加のみ・既存の LearnedRule とは別）。
/// action: include（この条件の予定では出す）/ exclude（出さない）。
/// scope: genre（ジャンル・カテゴリ）/ keyword（キーワード）/ similar（似た予定＝特徴の署名一致）。
model ChecklistScopeRule {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           String
  kind             String
  normTitle        String
  title            String
  scope            String
  genres           String   @default("[]")
  genreKeywords    String   @default("[]")
  keywords         String   @default("[]")
  categoryIds      String   @default("[]")
  signature        String?
  sourceEventId    String?
  sourceEventTitle String?
  reason           String?
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  eventScopes      EventChecklistScope[]

  @@index([userId, archivedAt])
}

/// 予定ごとの項目の範囲指定（項目は保存のたびに作り直されるため、(eventId, kind, normTitle) で持つ）。
/// scope: auto（従来の自動学習）/ event_only（この予定だけ）/ genre / keyword / similar。
/// status: proposed（AI の提案のまま適用中）/ chosen（ユーザーが選んだ）。
model EventChecklistScope {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind      String
  normTitle String
  title     String
  action    String
  scope     String
  ruleId    String?
  rule      ChecklistScopeRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  reason    String?
  source    String
  status    String   @default("proposed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, kind, normTitle])
  @@index([userId])
}
