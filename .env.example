# ── そなえ MVP 環境変数 ───────────────────────────────
# このファイルをコピーして .env を作成:  cp .env.example .env
# .env は .gitignore 済み（コミットしないこと）

# ── データベース (PostgreSQL / Neon) ──────────────────
# https://neon.tech で無料の Postgres を作成（カード不要）。
#   DATABASE_URL = "Pooled connection"（?sslmode=require&pgbouncer=true 付き）… アプリ実行用
#   DIRECT_URL   = "Direct connection"（プーラー無し）……………………… マイグレーション用
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── セッション署名鍵 ──────────────────────────────────
#   例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Google OAuth 2.0 / Google Calendar API ───────────
# Google Cloud Console で OAuth クライアント（種別: ウェブアプリケーション）を作成。
#   - 承認済みリダイレクト URI に GOOGLE_REDIRECT_URI と同じ値を登録
#   - Google Calendar API を有効化
#   - OAuth 同意画面のスコープ: .../auth/calendar.readonly, openid, email, profile
#   - 「テスト」モードのテストユーザーに利用者の Google アカウントを追加
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# ローカル: http://localhost:3000/api/auth/google/callback
# 本番:     https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── OpenAI API（準備リスト生成。未設定でもテンプレートで動作）──
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ── アプリの公開 URL（OAuth リダイレクト・通知リンク・cron が使用）──
# 本番では https://<your-app>.vercel.app
APP_BASE_URL="http://localhost:3000"

# ── Web Push 通知 ────────────────────────────────────
# 鍵を生成:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BB...(公開鍵)"
VAPID_PRIVATE_KEY="..(秘密鍵)"
VAPID_SUBJECT="mailto:you@example.com"

# ── 新規予定ポーリング（GitHub Actions から /api/cron/poll を叩く）──
#   例: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="change-me-random-hex"

# ── 開発用ログイン ───────────────────────────────────
# 本番(NODE_ENV=production)では自動的に無効。明示的に有効化したいときだけ true。
# ENABLE_DEV_LOGIN="false"
