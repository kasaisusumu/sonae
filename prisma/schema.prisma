// そなえ MVP — Prisma schema (PostgreSQL: 本番 Neon / ローカルも Neon 可)
// Data model follows docs/CLAUDE.md section 4.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  // native = ローカル、rhel-openssl-3.0.x = Vercel(サーバーレス)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // アプリ実行用（Neon の pooled 接続文字列）
  directUrl = env("DIRECT_URL")   // マイグレーション用（Neon の直結 接続文字列）
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())

  googleAccount  UserGoogleAccount?
  categories     Category[]
  events         Event[]
  failureLogs    FailureLog[]
  savingsEntries SavingsEntry[]
  feedback       Feedback[]
  pushSubscriptions PushSubscription[]
  listTemplates  ListTemplate[]
}

// Web Push の購読情報（1 ユーザーが複数端末を持てる）
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Google 連携用トークン管理。ログイン(認証)もこのアカウントで兼ねる。
model UserGoogleAccount {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccountEmail String
  accessToken        String
  refreshToken       String?
  tokenExpiry        DateTime?
  calendarId         String    @default("primary")
  lastSyncedAt       DateTime?
  // 差分同期トークン（events.list の nextSyncToken）
  syncToken          String?
  // Google Calendar push 通知（watch チャンネル）
  watchChannelId     String?
  watchResourceId    String?
  watchExpiration    DateTime?
  // 予定の説明欄への準備リスト書き込み（オプトイン。calendar.events スコープ許可済みで true）
  writeDescriptionEnabled Boolean @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  events       Event[]
  learnedRules LearnedRule[]
  editRecords  EditRecord[]
  failureLogs  FailureLog[]

  @@unique([userId, name])
}

model Event {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title         String
  eventDatetime DateTime
  endDatetime   DateTime?
  memo          String?
  googleEventId String?   @unique
  // 繰り返し予定の親イベントID（Google）。同じ系列の通知・生成をまとめるのに使う
  recurringEventId String?
  // 自動で準備リスト生成・説明欄書き込みの対象にするか。
  // 連携時に既にあった予定は false（無視）。連携後に追加された予定・アプリで編集した予定は true。
  autoManaged   Boolean   @default(true)
  // この予定の準備リストを個別に編集して、同名グループから切り離したか。
  // false = 同名の未編集予定と内容を共有（一方の編集は全体に波及）。
  listCustomized Boolean  @default(false)
  // 生成されたリストを、編集せずに「確認しました」と押した日時。
  // これが null かつ EditRecord も無いと「未確認」表示（説明欄にも注記）。
  listReviewedAt DateTime?
  source        String    @default("manual") // "google" | "manual"
  // 再発防止の警告をユーザーが確認・了承した日時（設定されると警告は畳まれる）
  failureWarningAckAt DateTime?
  // 新規追加の通知を送った日時（アプリを開いたときの準備リスト先行生成にも使う）
  notifiedAt    DateTime?
  // そなえが最後に説明欄へ書き込んだ内容のハッシュ（無限ループ／再書き込み防止）
  lastWrittenHash String?
  // 直近に取り込んだ「受信テキスト」のハッシュ（webhook と cron の二重取り込み・二重学習を防ぐ）
  lastInboundHash String?
  // （旧）クールダウン用。現在は未使用
  lastInboundEditAt DateTime?
  // 事後の「今回は防げた？」通知を送った日時（再送防止）
  postFailureCheckNotifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checklistItems ChecklistItem[]
  savingsEntries SavingsEntry[]
  failureLogs    FailureLog[]
  feature        EventFeature?
  editRecords    EditRecord[]

  @@index([userId, recurringEventId])
}

model ChecklistItem {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // "task" = 準備すること / "belonging" = 持ち物
  kind          String   @default("task")
  title         String
  timingLabel   String? // 例: "前日21時"
  comment       String? // ユーザーの自由メモ（学習対象外）
  isDone        Boolean  @default(false)
  isUserAdded   Boolean  @default(false)
  isUserRemoved Boolean  @default(false)
  sortOrder     Int      @default(0)
  // この項目の準備を促す通知を、予定開始の何分前に出すか。null = 通知しない。
  notifyLeadMinutes Int?
  // その通知を送った日時（再送防止）。リード時間を変えると null に戻す。
  notifiedAt        DateTime?
  createdAt     DateTime @default(now())

  // confidence の低い「提案」項目（ユーザーが1タップで適用/却下）
  isSuggested      Boolean @default(false)
  suggestionType   String? // "exclude" | "add" | "timing"
  suggestionRuleId String? // 元になった LearnedRule.id
  suggestionValue  String? // timing 提案のときの提案タイミング
}

// ── 学習ロジック（spec 9.2）: EventFeature + EditRecord + LearnedRule ──

// 予定の特徴量（軽いルールベース推定）
model EventFeature {
  id             String   @id @default(cuid())
  eventId        String   @unique
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isOverseas     Boolean? // タイトル・メモのキーワードから推定（不明なら null）
  durationNights Int? // 日付範囲から算出（日帰り=0、不明なら null）
  isWeekday      Boolean  @default(true)
  timeBucket     String? // "morning" | "afternoon" | "evening" | "allday"
  keywords       String   @default("[]") // json string[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 個々の編集の生ログ（イベント単位）
model EditRecord {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  addedItems    String    @default("[]") // json [{title, timingLabel}]
  removedItems  String    @default("[]") // json string[]
  timingChanges String    @default("{}") // json { title: timingLabel }
  notifyChanges String    @default("{}") // json { title: leadMinutes | null }
  createdAt     DateTime  @default(now())

  @@index([categoryId])
}

// EditRecord を集約した、提案時に参照するルール
model LearnedRule {
  id                String   @id @default(cuid())
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  featureSignature  String   @default("{}") // json {d?:duration, o?:overseas, w?:weekday, t?:timeBucket}
  itemKind          String   @default("task") // "task" | "belonging"
  ruleType          String // "exclude_item" | "fixed_item" | "timing_override"
  target            String // 対象項目名
  value             String? // timing_override / fixed_item のタイミングラベル
  confidence        Float    @default(0.35) // 0-1。反復確認で上昇、矛盾で低下、未更新で経年劣化
  confirmedCount    Int      @default(1) // 連続確認回数（矛盾でリセット）
  contradictedCount Int      @default(0) // 矛盾が起きた累計
  lastConfirmedAt   DateTime @default(now())
  isUserLocked      Boolean  @default(false) // 「学習内容の確認」画面で固定した
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([categoryId, itemKind, ruleType, target, featureSignature])
  @@index([categoryId, itemKind, ruleType])
}

model FailureLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // どの予定で起きた失敗か（任意）。指定すると、その予定に似た予定でだけ警告する
  eventId          String?
  event            Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // 失敗の内容（自由記述）。「遅刻した」「保険証を忘れた」など。金額はなくてよい
  description      String
  // 予定の特徴シグネチャ（spec 9.2 の {d,o,w,t}）。記録時にその場で確定する。
  // "{}" は「予定に紐づかない＝カテゴリ全体」を意味し、どの予定にも当たる。
  featureSignature String   @default("{}")
  // 推定損失額（円・任意。0 のままでもよい）
  estimatedLossYen Int      @default(0)
  // 振り返りの結果: null = 未選択 / "prevented" = 防げた / "not_prevented" = 防げなかった
  // ダッシュボードには "prevented" のものだけ残す。未選択は失敗ログ一覧で選ぶ。
  outcome          String?
  occurredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  savingsEntries SavingsEntry[]

  @@index([userId, categoryId])
}

model SavingsEntry {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  failureLogId    String?
  failureLog      FailureLog? @relation(fields: [failureLogId], references: [id], onDelete: SetNull)
  amountYen       Int         @default(0)
  confirmedByUser Boolean     @default(false)
  createdAt       DateTime    @default(now())

  // 1 予定 × 1 失敗ログ につき「防げた」は 1 回だけ計上する
  @@unique([eventId, failureLogId])
}

// 簡易フィードバック導線 (WTP アンケート)
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wtpYen    Int? // 月いくらなら払いたいか
  comment   String?
  screen    String? // どの画面から送信されたか
  createdAt DateTime @default(now())
}

// 名前を付けて保存できる準備リストのテンプレート。
// 「準備すること(task)」用と「持ち物(belonging)」用で分ける。
// 予定の現在のリストから作るほか、学習内容ページで新規作成・編集もできる。
model ListTemplate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String   @default("task") // "task" | "belonging"
  name          String
  note          String?
  sourceEventId String? // どの予定のリストから作ったか（参照用）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items ListTemplateItem[]

  @@unique([userId, kind, name])
  @@index([userId])
}

model ListTemplateItem {
  id                String       @id @default(cuid())
  templateId        String
  template          ListTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind              String       @default("task") // "task" | "belonging"
  title             String
  notifyLeadMinutes Int?
  sortOrder         Int          @default(0)

  @@index([templateId])
}
